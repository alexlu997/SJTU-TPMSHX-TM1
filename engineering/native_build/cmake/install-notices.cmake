# Keep the installed notice paths stable when a source directory moves.
set(notice_list "${TPMSHX_ROOT}/engineering/native_build/notice-files.tsv")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${notice_list}")
file(STRINGS "${notice_list}" notice_entries)
foreach(entry IN LISTS notice_entries)
    string(REPLACE "\t" ";" pair "${entry}")
    list(GET pair 0 source)
    list(GET pair 1 installed)
    get_filename_component(directory "${installed}" DIRECTORY)
    if(source MATCHES "\\.md$")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${TPMSHX_ROOT}/${source}")
        file(READ "${TPMSHX_ROOT}/${source}" document)
        get_filename_component(parent "${TPMSHX_ROOT}/${source}" DIRECTORY)
        foreach(target IN LISTS notice_entries)
            string(REPLACE "\t" ";" pair "${target}")
            list(GET pair 0 source_target)
            list(GET pair 1 installed_target)
            file(RELATIVE_PATH old "${parent}" "${TPMSHX_ROOT}/${source_target}")
            file(RELATIVE_PATH new "${TPMSHX_ROOT}/${directory}" "${TPMSHX_ROOT}/${installed_target}")
            string(REPLACE "](${old})" "](${new})" document "${document}")
            string(REPLACE "](${old}#" "](${new}#" document "${document}")
        endforeach()
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/notices/${directory}")
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/notices/${installed}" "${document}")
        set(file "${CMAKE_CURRENT_BINARY_DIR}/notices/${installed}")
    else()
        set(file "${TPMSHX_ROOT}/${source}")
    endif()
    install(FILES "${file}" DESTINATION "${CMAKE_INSTALL_DATADIR}/tpmshx/${directory}")
endforeach()
