include LICENSE README.md README.en.md pyproject.toml requirements.txt
include CMakeLists.txt
graft native
graft tests/cpp
include main.py tm1.py tests/__init__.py
graft python
graft tests/python
graft engineering
graft docs
graft examples
prune native/lib
prune python/development/runs/_out
prune python/opt_runs
prune python/nTop_inputs
prune python/.agents
prune docs/superpowers
global-exclude *.xlsx *.xlsm .last_session_*.json .workspace .theme .density .accent .user_presets.json
prune .cache
prune data
prune .venv
prune .git
prune build
prune dist
global-exclude *.pyc *.pyo *.nbi *.nbc
global-exclude *.a *.lib *.dylib *.dll *.so *.o *.obj *.pdb *.exe
global-exclude *.h5 *.hdf5 *.npz *.npy *.checkpoint *.ckpt
global-exclude .venv-path .last_session.json .session_timeline.jsonl .first_run_done
